# Copy this file to .env. Never commit the real .env file.
POSTGRES_DB=crimewatch
POSTGRES_USER=crimewatch
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=jdbc:postgresql://postgres:5432/crimewatch
DATABASE_USERNAME=crimewatch
DATABASE_PASSWORD=change-me-locally
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000
VITE_API_URL=/api
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

